{
  "name": "vlement-artwork-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-certificates.mjs",
    "dev": "astro dev",
    "prestart": "node scripts/prepare-certificates.mjs",
    "start": "astro dev",
    "prebuild": "node scripts/prepare-certificates.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare:certificates": "node scripts/prepare-certificates.mjs",
    "test:worker": "vitest run --config workers/certificates/vitest.config.ts",
    "typecheck:worker": "wrangler types workers/certificates/worker-configuration.d.ts --config workers/certificates/wrangler.jsonc && tsc --noEmit --project workers/certificates/tsconfig.json",
    "test": "npm run test:worker",
    "worker:dev": "wrangler dev --config workers/certificates/wrangler.jsonc --var ALLOWED_ORIGIN:http://localhost:4321",
    "worker:migrate:local": "wrangler d1 migrations apply vlement-certificates-local --local --config workers/certificates/wrangler.jsonc"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/tailwind": "^5.1.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.50.0"
  }
}
