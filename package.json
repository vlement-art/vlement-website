{
  "name": "vlement-artwork-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-certificates.mjs",
    "dev": "astro dev",
    "prestart": "node scripts/prepare-certificates.mjs",
    "start": "astro dev",
    "prebuild": "node scripts/prepare-certificates.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare:certificates": "node scripts/prepare-certificates.mjs",
    "test:worker": "vitest run --config workers/certificates/vitest.config.ts",
    "test:pdf": "node --test test/certificate-pdf.test.mjs",
    "test:admin-editor": "node --test test/admin-editor.test.mjs",
    "test:artwork-card": "npm run build && node --test test/artwork-card-enquiry.test.mjs",
    "test:backfill": "node --test test/backfill-artwork-codes.test.mjs",
    "codes:backfill": "node scripts/backfill-artwork-codes.mjs",
    "typecheck:worker": "wrangler types workers/certificates/worker-configuration.d.ts --env staging --config workers/certificates/wrangler.jsonc && tsc --noEmit --project workers/certificates/tsconfig.json",
    "test": "npm run test:worker",
    "worker:dev": "wrangler dev --config workers/certificates/wrangler.jsonc --var ALLOWED_ORIGIN:http://localhost:4321",
    "worker:migrate:local": "wrangler d1 migrations apply vlement-certificates-local --local --config workers/certificates/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.3",
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^4.16.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.50.0"
  }
}
