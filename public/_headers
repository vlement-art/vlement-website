# Cloudflare Pages reads this file automatically and applies these headers to
# every response. GitHub Pages does NOT support custom response headers at
# all — it silently ignores this file. See README.md "Security" for exactly
# what GitHub Pages can and cannot enforce, and how to get these same headers
# there (Cloudflare in front of GitHub Pages).

# NOTE on script-src: every script in this project is external/bundled
# EXCEPT the tiny theme-flash-prevention snippet in src/layouts/BaseLayout.astro,
# which must run inline, before paint, to avoid a flicker between light/dark
# mode. It's allowed here by exact sha256 hash rather than 'unsafe-inline'.
# If you EDIT that script, you must regenerate this hash — see README.md
# "Security > Regenerating the inline script hash" for the exact command.
# If the hash and the script ever go out of sync, the browser simply blocks
# the script (theme still works via the non-inline toggle, you just get a
# brief flash of the wrong theme on load) — it fails closed, not open.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formspree.io https://api.web3forms.com; script-src 'self' 'sha256-rVWJc7RZYLx/ujrEcl5PMTdETrfdqK8kKu+qVA5lTuE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; require-trusted-types-for 'script'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
# If you don't use a contact form service, remove the two form-action URLs
# above and leave just: form-action 'self'
