---
interface Props {
  slug: string;
  title: string;
  year: number;
  medium: string;
  dimensions: string;
  thumbnail: string;
  altText: string;
  width: number;
  height: number;
  category: string;
  collection: string;
  available: boolean;
  price?: string;
  /** Set true for the first few cards above the fold so their images load eagerly. */
  eager?: boolean;
}

const {
  slug,
  title,
  year,
  medium,
  dimensions,
  thumbnail,
  altText,
  width,
  height,
  category,
  collection,
  available,
  price,
  eager = false,
} = Astro.props;
const imageWidth = Math.min(100, Math.max(55, Math.sqrt(width / height) * 80));
---

<article
  class="artwork-card group"
  data-title={title.toLowerCase()}
  data-medium={medium.toLowerCase()}
  data-category={category.toLowerCase()}
  data-collection={collection.toLowerCase()}
>
  <a href={`/work/${slug}`} class="block">
    <div class="flex items-center justify-center">
      <img
        src={thumbnail}
        alt={altText}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={`width: ${imageWidth}%`}
        class="block h-auto max-h-[75vh] object-contain"
      />
    </div>
    <div class="mt-3">
      <h3 class="font-original text-lg italic">{title}</h3>
      {(year || medium) && (
        <p class="mt-1 text-sm text-muted">
          {year}
          {year && medium && ' · '}
          {medium}
        </p>
      )}
      {dimensions && <p class="mt-1 text-sm text-muted">{dimensions}</p>}
      <div class="mt-2 flex items-center gap-3 text-xs">
        {available ? (
          <span class="border border-accent px-2 py-0.5 uppercase tracking-wide text-accent-dark">Available</span>
        ) : (
          <span class="border border-line px-2 py-0.5 uppercase tracking-wide text-muted">Sold</span>
        )}
        {price && <strong class="text-accent-dark">{price}</strong>}
      </div>
    </div>
  </a>
</article>
