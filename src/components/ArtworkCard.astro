---
interface Props {
  slug: string;
  title: string;
  year: number;
  medium: string;
  thumbnail: string;
  altText: string;
  category: string;
  collection: string;
  available: boolean;
  price?: string;
  /** Set true for the first few cards above the fold so their images load eagerly. */
  eager?: boolean;
}

const {
  slug,
  title,
  year,
  medium,
  thumbnail,
  altText,
  category,
  collection,
  available,
  price,
  eager = false,
} = Astro.props;
---

<article
  class="artwork-card group"
  data-title={title.toLowerCase()}
  data-medium={medium.toLowerCase()}
  data-category={category.toLowerCase()}
  data-collection={collection.toLowerCase()}
>
  <a href={`/work/${slug}`} class="block">
    <div class="overflow-hidden bg-[color-mix(in_srgb,var(--paper)_75%,#888_25%)]" style="aspect-ratio: 4 / 5;">
      <img
        src={thumbnail}
        alt={altText}
        width="640"
        height="800"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </div>
    <div class="mt-3">
      <h3 class="font-serif text-lg italic">{title}</h3>
      <p class="mt-1 text-sm text-muted">{year} · {medium}</p>
      <div class="mt-2 flex items-center gap-3 text-xs">
        {available ? (
          <span class="border border-accent px-2 py-0.5 uppercase tracking-wide text-accent-dark">Available</span>
        ) : (
          <span class="border border-line px-2 py-0.5 uppercase tracking-wide text-muted">Sold</span>
        )}
        {price && <strong class="text-accent-dark">{price}</strong>}
      </div>
    </div>
  </a>
</article>
