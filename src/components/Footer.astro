---
import { site } from '../data/site';
---

<footer class="mx-auto flex max-w-6xl flex-col gap-2 border-t border-line px-6 py-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
  <span>&copy; {site.copyrightYear} {site.artistName}. All images and content are protected by copyright and may not be reproduced without permission.</span>
  <span class="flex gap-4">
    <a href="/privacy" class="hover:text-ink hover:underline">Privacy</a>
    <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="hover:text-ink hover:underline">Instagram</a>
  </span>
</footer>
