---
// A single, page-level lightbox. Any <img> with data-lightbox-src (and
// optional data-lightbox-caption) opens it. Used on the gallery page so
// visitors can preview a larger image without leaving the grid.
---

<dialog id="lightbox" class="lightbox-dialog" aria-label="Artwork preview">
  <div class="relative">
    <button type="button" id="lightboxClose" class="lightbox-close" aria-label="Close artwork preview">
      &times;
    </button>
    <button type="button" id="lightboxPrev" class="lightbox-nav lightbox-prev" aria-label="Previous artwork">
      &#8249;
    </button>
    <img id="lightboxImage" src="" alt="" />
    <button type="button" id="lightboxNext" class="lightbox-nav lightbox-next" aria-label="Next artwork">
      &#8250;
    </button>
    <p id="lightboxCaption" class="lightbox-caption"></p>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    width: min(94vw, 1100px);
    max-width: none;
    padding: 0;
    border: 0;
    color: #fff;
    background: #111;
  }
  .lightbox-dialog::backdrop {
    background: rgb(0 0 0 / 86%);
  }
  .lightbox-dialog img {
    display: block;
    width: 100%;
    max-height: 82vh;
    object-fit: contain;
    background: #111;
  }
  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;
    background: rgb(0 0 0 / 55%);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.3rem;
    line-height: 1;
  }
  .lightbox-close {
    top: 0.75rem;
    right: 0.75rem;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-prev {
    left: 0.75rem;
  }
  .lightbox-next {
    right: 0.75rem;
  }
  .lightbox-caption {
    padding: 0.8rem 1rem 1rem;
    color: #ddd;
    font-size: 0.9rem;
  }
</style>

<script>
  (function () {
    var dialog = document.getElementById('lightbox');
    var img = document.getElementById('lightboxImage');
    var caption = document.getElementById('lightboxCaption');
    var closeBtn = document.getElementById('lightboxClose');
    var prevBtn = document.getElementById('lightboxPrev');
    var nextBtn = document.getElementById('lightboxNext');
    if (!dialog || !img || !closeBtn) return;

    var triggers = [];
    var currentIndex = -1;
    var lastFocused = null;

    function refreshTriggers() {
      triggers = Array.prototype.slice.call(document.querySelectorAll('[data-lightbox-src]'));
    }
    refreshTriggers();

    function openAt(index) {
      if (index < 0 || index >= triggers.length) return;
      currentIndex = index;
      var el = triggers[index];
      img.src = el.getAttribute('data-lightbox-src') || '';
      img.alt = el.getAttribute('data-lightbox-alt') || '';
      caption.textContent = el.getAttribute('data-lightbox-caption') || '';
      lastFocused = document.activeElement;
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      }
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      updateNavVisibility();
    }

    function updateNavVisibility() {
      var multiple = triggers.length > 1;
      prevBtn.style.display = multiple ? '' : 'none';
      nextBtn.style.display = multiple ? '' : 'none';
    }

    function close() {
      dialog.close();
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    function step(delta) {
      if (triggers.length === 0) return;
      var next = (currentIndex + delta + triggers.length) % triggers.length;
      openAt(next);
    }

    refreshTriggers();
    triggers.forEach(function (el, index) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        refreshTriggers();
        openAt(index);
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', function () {
      step(-1);
    });
    nextBtn.addEventListener('click', function () {
      step(1);
    });

    // Click on the backdrop (not the image or controls) closes the dialog.
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) close();
    });

    dialog.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        // <dialog> already closes on Escape natively; this just ensures cleanup.
      } else if (e.key === 'ArrowRight') {
        step(1);
      } else if (e.key === 'ArrowLeft') {
        step(-1);
      }
    });

    dialog.addEventListener('close', function () {
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    });
  })();
</script>
