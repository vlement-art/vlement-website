---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute URL of a page-specific social preview image, if different from the default. */
  ogImage?: string;
  /** Canonical path, e.g. "/work/sad-bunny" — defaults to the current URL path. */
  canonicalPath?: string;
  /** Extra JSON-LD structured data object(s) to inject, in addition to the default Person schema. */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  ogImage,
  canonicalPath = Astro.url.pathname,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, site.url).toString();
const socialImage = ogImage ?? new URL('/images/artist/og-default.webp', site.url).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.artistName,
  url: site.url,
  jobTitle: 'Artist',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  sameAs: [site.social.instagram.url],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f8f6f1" />
    <meta name="author" content={site.artistName} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={site.artistName} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!--
      Security headers (CSP, Referrer-Policy, X-Content-Type-Options,
      Permissions-Policy, X-Frame-Options) are NOT set via <meta> tags here.
      Most of them either do nothing (frame-ancestors, and X-Frame-Options
      isn't a valid meta http-equiv at all) or shouldn't be duplicated as
      meta when a real header exists. They are configured in /public/_headers
      for Cloudflare Pages — see README.md "Security" section for what
      GitHub Pages can and cannot enforce.
    -->

    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      // Reads a previously saved choice; otherwise follows the OS preference.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {
          /* localStorage may be unavailable (private mode); default theme applies. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
