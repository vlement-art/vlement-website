---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitionDateUpdater from '../components/ExhibitionDateUpdater.astro';
import { site } from '../data/site';
import exhibitionsData from '../data/exhibitions.json';
import { formatExhibitionDates, getExhibitionGroups } from '../data/exhibitions';

// EDIT ME: replace with a real CV file in /public/documents/ once you have one,
// or remove the link in the template below if you don't want to offer a CV.
const cvUrl = '/documents/cv.pdf';

const exhibitions = getExhibitionGroups(exhibitionsData);
const timeline = [
  { year: '2026', text: 'Began the Yellow Balloon series.' },
  { year: '2024–2025', text: 'Coastal Studies series developed from location drawings made in London and along the south coast.' },
];
---

<BaseLayout
  title={`About — ${site.artistName}`}
  description={`Biography and artist statement for ${site.artistName}, a painter and printmaker based in ${site.location}.`}
  canonicalPath="/about"
>
  <section class="mx-auto grid max-w-5xl gap-10 px-6 py-16 sm:grid-cols-[1fr_1.4fr] sm:py-20">
    <div>
      <img
        src="/images/artist/portrait.webp"
        alt={`Portrait of ${site.artistName} in the studio`}
        width="640"
        height="800"
        loading="eager"
        decoding="async"
        style="aspect-ratio: 4 / 5;"
        class="w-full object-cover"
      />
    </div>
    <div>
      <p class="mb-2 text-xs uppercase tracking-[0.22em] text-muted">About the artist</p>
      <h1 class="font-serif text-5xl italic leading-tight sm:text-6xl">{site.artistName}</h1>

      <div class="prose-body mt-6 max-w-md text-muted">
        <p>
          <!-- EDIT ME: replace with your real biography. -->
          {site.artistName} is a painter and printmaker based in {site.location}, working across
          oil, mixed media and limited-edition print. The practice returns again and again to a
          small number of recurring subjects, reworking each one across paintings, drawings and
          prints until it reveals something new.
        </p>
        <p>
          I need to paint the same subject over and over again, to uncover its different aspects,
          its different meanings, its different lives. Somewhere between painting, collage and
          printmaking, the image becomes a place to return to — each time slightly changed.
        </p>
      </div>

      <h2 class="mt-10 font-serif text-2xl italic">Exhibitions & highlights</h2>
      <ul class="mt-4 space-y-4 border-t border-line pt-4 text-sm">
        {exhibitions.current.map((item) => (
          <li class="flex gap-4" data-about-exhibition data-start-date={item.startDate} data-end-date={item.endDate}>
            <span class="w-24 flex-none text-muted" data-exhibition-status-label>On now</span>
            <span>{item.title} · {item.venue} · {formatExhibitionDates(item)}</span>
          </li>
        ))}
        {exhibitions.upcoming.map((item) => (
          <li class="flex gap-4" data-about-exhibition data-start-date={item.startDate} data-end-date={item.endDate}>
            <span class="w-24 flex-none text-muted" data-exhibition-status-label>{new Date(`${item.startDate}T00:00:00.000Z`).getUTCFullYear()} (upcoming)</span>
            <span>{item.title} · {item.venue} · {formatExhibitionDates(item)}</span>
          </li>
        ))}
        {exhibitions.past.map((item) => (
          <li class="flex gap-4" data-about-exhibition data-start-date={item.startDate} data-end-date={item.endDate}>
            <span class="w-24 flex-none text-muted" data-exhibition-status-label>{new Date(`${item.endDate}T00:00:00.000Z`).getUTCFullYear()}</span>
            <span>{item.title} · {item.venue} · {formatExhibitionDates(item)}</span>
          </li>
        ))}
        {timeline.map((item) => (
          <li class="flex gap-4">
            <span class="w-24 flex-none text-muted">{item.year}</span>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>

      <a href={cvUrl} class="mt-8 inline-block text-sm text-accent-dark hover:underline" download>
        Download CV (PDF)
      </a>
      <!-- EDIT ME: remove the link above if /public/documents/cv.pdf does not exist yet. -->
    </div>
  </section>
</BaseLayout>

<ExhibitionDateUpdater />
