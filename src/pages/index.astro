---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { formatDimensions } from '../lib/dimensions.mjs';
import ExhibitionDateUpdater from '../components/ExhibitionDateUpdater.astro';
import homepageSettings from '../data/homepage.json';
import exhibitionsData from '../data/exhibitions.json';
import { formatExhibitionDates, getExhibitionGroups } from '../data/exhibitions';

const allArtworks = await getCollection('artworks');
const featured = allArtworks
  .filter((a) => a.data.featured)
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
const heroArtwork = allArtworks.find((artwork) => artwork.slug === homepageSettings.heroSlug)
  ?? featured[0]
  ?? [...allArtworks].sort((a, b) => a.data.displayOrder - b.data.displayOrder)[0];
const heroImage = heroArtwork && homepageSettings.heroSlug === heroArtwork.slug
  && homepageSettings.heroImageField === 'thumbnail'
  ? heroArtwork.data.thumbnail
  : heroArtwork?.data.image;
const heroMaxWidthVh = heroArtwork ? (85 * heroArtwork.data.width) / heroArtwork.data.height : 0;
const selectedWorks = heroArtwork
  ? featured.filter((artwork) => artwork.slug !== heroArtwork.slug)
  : featured;

const exhibitions = getExhibitionGroups(exhibitionsData);
---

<BaseLayout title={`${site.artistName} | Original Paintings & Limited Edition Prints`} description={site.description}>
  <section class="mx-auto grid min-h-[100svh] max-w-6xl items-center justify-items-center gap-8 bg-paper px-6 pb-16 pt-8 sm:gap-12 sm:pb-24 sm:pt-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16" aria-labelledby="hero-heading">
    {heroArtwork && (
      <a
        href={`/work/${heroArtwork.slug}`}
        class="group order-first flex w-full flex-col items-center justify-center"
        aria-label={`View ${heroArtwork.data.title}`}
      >
        <div
          class="flex items-center justify-center bg-paper"
          style={`aspect-ratio: ${heroArtwork.data.width} / ${heroArtwork.data.height}; width: min(100%, ${heroMaxWidthVh}svh); max-height: 85svh; max-width: 100%;`}
        >
          <img
            src={heroImage}
            alt={heroArtwork.data.altText}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-contain bg-transparent"
          />
        </div>
        <div class="mt-3 flex w-full flex-col gap-1 text-xs text-muted sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-x-4">
          <span class="font-original text-base italic text-ink">{heroArtwork.data.title}</span>
          {(heroArtwork.data.year || heroArtwork.data.medium) && (
            <span>
              {heroArtwork.data.year}
              {heroArtwork.data.year && heroArtwork.data.medium && ' · '}
              {heroArtwork.data.medium}
            </span>
          )}
          {heroArtwork.data.dimensions && <span>{formatDimensions(heroArtwork.data.dimensions)}</span>}
        </div>
      </a>
    )}
    <div class="w-full lg:py-12">
      <p class="mb-5 text-xs uppercase tracking-[0.22em] text-muted">
        {site.location} · Painting · Mixed media · Printmaking
      </p>
      <h1 id="hero-heading" class="max-w-xl font-original text-5xl italic leading-[0.92] tracking-tight sm:text-7xl">
        {site.shortName} <span class="block text-3xl leading-tight sm:text-5xl">J. Rodrigues</span>
      </h1>
      <p class="max-w-xl font-original text-5xl italic leading-[0.92] tracking-tight sm:text-7xl">One subject.<br />Many lives.</p>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted sm:mt-8 sm:text-lg">
        Original paintings and limited-edition prints by {site.artistName}.
      </p>
      <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href="/work" class="border-b border-ink pb-1 hover:text-accent-dark">
          Explore the work <span aria-hidden="true">↗</span>
        </a>
        <a href="/about" class="border-b border-line pb-1 text-muted hover:border-ink hover:text-ink">
          Artist&apos;s practice
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24" aria-labelledby="featured-heading">
    <div class="mb-8 flex items-end justify-between gap-4 border-t border-line pt-10 sm:mb-10 sm:pt-12">
      <div>
        <p class="mb-2 text-xs uppercase tracking-[0.22em] text-muted">A selection</p>
        <h2 id="featured-heading" class="font-original text-3xl italic sm:text-4xl">Selected works</h2>
      </div>
      <a href="/work" class="text-xs uppercase tracking-wider text-muted hover:text-ink">View all &rarr;</a>
    </div>
    <div class="grid grid-cols-1 items-start gap-x-8 gap-y-12 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-16">
      {selectedWorks.map((artwork, i) => (
        <ArtworkCard
          slug={artwork.slug}
          title={artwork.data.title}
          year={artwork.data.year}
          medium={artwork.data.medium}
          dimensions={artwork.data.dimensions}
          thumbnail={artwork.data.thumbnail}
          altText={artwork.data.altText}
          width={artwork.data.width}
          height={artwork.data.height}
          category={artwork.data.category}
          collection={artwork.data.collection}
          editionType={artwork.data.editionType}
          editionSize={artwork.data.editionSize}
          available={artwork.data.available}
          price={artwork.data.price}
          eager={i === 0}
        />
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 border-t border-line px-6 py-20 sm:grid-cols-[0.8fr_1fr] sm:gap-10 sm:py-24" aria-labelledby="about-heading">
    <h2 id="about-heading" class="font-serif text-4xl italic leading-[0.95] sm:text-6xl">
      One subject.<br />Many lives.
    </h2>
    <div class="max-w-md">
      <p class="text-xl">
        I need to paint the same subject over and over again, to uncover its different aspects,
        its different meanings, its different lives.
      </p>
      <p class="mt-4 text-muted">
        Somewhere between painting, collage and printmaking, the image becomes a place to return
        to — each time slightly changed.
      </p>
      <a href="/about" class="mt-4 inline-block text-sm text-accent-dark hover:underline">Read more about the practice</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl border-t border-line px-6 py-20 sm:py-24" aria-labelledby="exhibitions-heading">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-xs uppercase tracking-[0.22em] text-muted">Selected appearances</p>
        <h2 id="exhibitions-heading" class="font-serif text-3xl italic sm:text-4xl">Exhibitions</h2>
      </div>
    </div>
    <div class="space-y-12">
      {exhibitions.current.length > 0 && (
        <div data-exhibition-section="current" hidden={exhibitions.current.length === 0}>
          <h3 class="mb-3 text-xs uppercase tracking-[0.18em] text-muted">On now</h3>
          <ul class="border-y border-line" data-exhibition-list="current">
            {exhibitions.current.map((ex) => (
              <li class="grid gap-4 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center sm:gap-8 sm:py-8"
                data-exhibition-item data-start-date={ex.startDate} data-end-date={ex.endDate}>
                <p class="text-xs uppercase tracking-wider text-muted">{formatExhibitionDates(ex)}</p>
                <div>
                  <h4 class="font-serif text-2xl italic sm:text-3xl">{ex.title}</h4>
                  <p class="mt-1 text-sm text-muted">{ex.venue}</p>
                </div>
                {ex.url && (
                  <a href={ex.url} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-accent-dark">
                    Exhibition details <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
      {exhibitions.upcoming.length > 0 && (
        <div data-exhibition-section="upcoming" hidden={exhibitions.upcoming.length === 0}>
          <h3 class="mb-3 text-xs uppercase tracking-[0.18em] text-muted">Coming up</h3>
          <ul class="border-y border-line" data-exhibition-list="upcoming">
            {exhibitions.upcoming.map((ex) => (
              <li class="grid gap-4 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center sm:gap-8 sm:py-8"
                data-exhibition-item data-start-date={ex.startDate} data-end-date={ex.endDate}>
                <p class="text-xs uppercase tracking-wider text-muted">{formatExhibitionDates(ex)}</p>
                <div>
                  <h4 class="font-serif text-2xl italic sm:text-3xl">{ex.title}</h4>
                  <p class="mt-1 text-sm text-muted">{ex.venue}</p>
                </div>
                {ex.url && (
                  <a href={ex.url} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-accent-dark">
                    Exhibition details <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
      {exhibitions.past.length > 0 && (
        <div data-exhibition-section="past" hidden={exhibitions.past.length === 0}>
          <h3 class="mb-3 text-xs uppercase tracking-[0.18em] text-muted">Past exhibitions</h3>
          <ul class="border-y border-line" data-exhibition-list="past">
            {exhibitions.past.map((ex) => (
              <li class="grid gap-4 py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-center sm:gap-8 sm:py-8"
                data-exhibition-item data-start-date={ex.startDate} data-end-date={ex.endDate}>
                <p class="text-xs uppercase tracking-wider text-muted">{formatExhibitionDates(ex)}</p>
                <div>
                  <h4 class="font-serif text-2xl italic sm:text-3xl">{ex.title}</h4>
                  <p class="mt-1 text-sm text-muted">{ex.venue}</p>
                </div>
                {ex.url && (
                  <a href={ex.url} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-accent-dark">
                    Exhibition details <span aria-hidden="true">↗</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="border-y border-line py-6 text-sm text-muted"
        data-exhibitions-empty hidden={exhibitions.current.length + exhibitions.upcoming.length + exhibitions.past.length > 0}>
        Exhibition details will be announced here.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl border-t border-line px-6 py-20 sm:py-24" aria-labelledby="contact-heading">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="mb-2 text-xs uppercase tracking-[0.22em] text-muted">Private enquiries · Prints · Originals</p>
        <h2 id="contact-heading" class="max-w-xl font-serif text-4xl italic leading-[0.95] sm:text-5xl">
          Find a piece to return to.
        </h2>
      </div>
      <a
        href="/contact"
        class="inline-flex min-h-[2.75rem] items-center justify-center border border-ink bg-ink px-5 py-2 text-xs uppercase tracking-wider text-paper"
      >
        Contact the artist
      </a>
    </div>
  </section>
</BaseLayout>

<ExhibitionDateUpdater />
