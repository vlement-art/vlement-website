---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkGallery from '../../components/ArtworkGallery.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { artworkEnquiryLink } from '../../lib/artwork-enquiry.mjs';
import { formatDimensions } from '../../lib/dimensions.mjs';
import { artworkTitle, artworkDescription } from '../../lib/artwork-seo.mjs';

export async function getStaticPaths() {
  const artworks = (await getCollection('artworks')).sort(
    (a, b) => a.data.displayOrder - b.data.displayOrder
  );
  return artworks.map((artwork, index) => ({
    params: { slug: artwork.slug },
    props: {
      artwork,
      prev: artworks[(index - 1 + artworks.length) % artworks.length],
      next: artworks[(index + 1) % artworks.length],
    },
  }));
}

const { artwork, prev, next } = Astro.props;
const { Content } = await artwork.render();
const data = artwork.data;

const title = artworkTitle(data);
const description = artworkDescription(data, artwork.body);
const pageURL = new URL(`/work/${artwork.slug}`, site.url).toString();
const imageURL = new URL(data.image, site.url).toString();
const enquiryLink = artworkEnquiryLink(data, pageURL);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: data.title,
  creator: {
    '@type': 'Person',
    name: site.artistName,
  },
  dateCreated: String(data.year),
  artMedium: data.medium,
  artworkSurface: data.medium,
  width: data.dimensions,
  height: data.dimensions,
  image: imageURL,
  url: pageURL,
  description: data.summary,
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={imageURL}
  canonicalPath={`/work/${artwork.slug}`}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-6xl px-6 py-5 sm:py-12">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs uppercase tracking-wider text-muted sm:mb-10">
      <a href="/work" class="hover:text-ink">Gallery</a> <span aria-hidden="true">/</span> {data.title}
    </nav>

    <div class="grid items-start gap-8 sm:grid-cols-[1.2fr_0.8fr] sm:gap-16">
      <div class="order-2 sm:order-1">
        <ArtworkGallery
          title={data.title}
          year={data.year}
          medium={data.medium}
          dimensions={data.dimensions}
          image={data.image}
          imageZoom={data.imageZoom}
          imageLabel={data.imageLabel}
          imageCaption={data.imageCaption}
          altText={data.altText}
          images={data.images}
        />
        <p class="mt-3 text-xs text-muted">
          &copy; {site.copyrightYear} {site.artistName}. Image shown at reduced resolution; not for reproduction.
        </p>
        {(data.portraitDownload || data.landscapeDownload) && (
          <div class="mt-4 flex flex-wrap gap-3 text-xs uppercase tracking-wider">
            {data.portraitDownload && (
              <a href={data.portraitDownload} download class="border border-line px-3 py-2 hover:border-ink">
                Download portrait
              </a>
            )}
            {data.landscapeDownload && (
              <a href={data.landscapeDownload} download class="border border-line px-3 py-2 hover:border-ink">
                Download landscape
              </a>
            )}
          </div>
        )}
      </div>

      <div class="contents sm:sticky sm:top-24 sm:order-2 sm:block">
        <div class="order-1">
          <p class="mb-2 text-xs uppercase tracking-[0.22em] text-muted sm:mb-3">Artwork · {data.collection}</p>
          <h1 class="font-original text-3xl italic leading-tight sm:text-6xl">{data.title}</h1>
          <p class="mt-2 text-muted">{data.year} · {data.medium}</p>
          {data.price && <p class="mt-3 text-lg font-bold text-accent-dark">{data.price}</p>}
          <p class="mt-4 text-sm">{data.available ? 'Available' : 'Sold'}</p>
          {data.available ? (
            <a
              href={enquiryLink}
              class="mt-2 inline-flex min-h-[2.75rem] w-full items-center justify-center border border-ink px-4 py-2 text-xs uppercase tracking-wider hover:bg-ink hover:text-paper sm:w-auto"
              aria-label={`Request information about ${data.title}`}
            >
              Request information
            </a>
          ) : (
            <a href={enquiryLink} class="mt-2 inline-flex min-h-[2.75rem] items-center text-sm text-muted underline underline-offset-4 hover:text-ink">
              Ask about similar works
            </a>
          )}
        </div>

        <div class="order-3">
          <dl class="grid grid-cols-2 gap-x-5 gap-y-6 border-y border-line py-7 text-sm sm:mt-8">
            <div>
              <dt class="text-xs uppercase tracking-wide text-muted">Dimensions</dt>
              <dd class="mt-1">{formatDimensions(data.dimensions)}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-muted">Collection</dt>
              <dd class="mt-1">{data.collection}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wide text-muted">Category</dt>
              <dd class="mt-1">{data.category}</dd>
            </div>
          </dl>

          <div class="prose-body mt-8 max-w-prose text-base leading-relaxed text-muted">
            <Content />
          </div>
        </div>
      </div>
    </div>

    <nav class="mt-20 flex items-center justify-between border-t border-line pt-6 text-sm sm:mt-24" aria-label="Artwork navigation">
      <a href={`/work/${prev.slug}`} class="max-w-[45%] hover:text-accent-dark">
        <span class="block text-xs uppercase tracking-wide text-muted">&larr; Previous</span>
        <span class="font-original italic">{prev.data.title}</span>
      </a>
      <a href={`/work/${next.slug}`} class="max-w-[45%] text-right hover:text-accent-dark">
        <span class="block text-xs uppercase tracking-wide text-muted">Next &rarr;</span>
        <span class="font-original italic">{next.data.title}</span>
      </a>
    </nav>
  </article>

</BaseLayout>
