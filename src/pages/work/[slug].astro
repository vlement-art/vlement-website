---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const artworks = (await getCollection('artworks')).sort(
    (a, b) => a.data.displayOrder - b.data.displayOrder
  );
  return artworks.map((artwork, index) => ({
    params: { slug: artwork.slug },
    props: {
      artwork,
      prev: artworks[(index - 1 + artworks.length) % artworks.length],
      next: artworks[(index + 1) % artworks.length],
    },
  }));
}

const { artwork, prev, next } = Astro.props;
const { Content } = await artwork.render();
const data = artwork.data;

const title = `${data.title} (${data.year}) — ${site.artistName}`;
const pageURL = new URL(`/work/${artwork.slug}`, site.url).toString();
const imageURL = new URL(data.image, site.url).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: data.title,
  creator: {
    '@type': 'Person',
    name: site.artistName,
  },
  dateCreated: String(data.year),
  artMedium: data.medium,
  artworkSurface: data.medium,
  width: data.dimensions,
  height: data.dimensions,
  image: imageURL,
  url: pageURL,
  description: data.summary,
};
---

<BaseLayout
  title={title}
  description={data.summary}
  ogImage={imageURL}
  canonicalPath={`/work/${artwork.slug}`}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs uppercase tracking-wider text-muted">
      <a href="/work" class="hover:text-ink">Gallery</a> <span aria-hidden="true">/</span> {data.title}
    </nav>

    <div class="grid gap-10 sm:grid-cols-[1.2fr_1fr] sm:gap-14">
      <div>
        <button
          type="button"
          class="block w-full border-0 bg-transparent p-0"
          data-lightbox-src={data.image}
          data-lightbox-alt={data.altText}
          data-lightbox-caption={`${data.title}, ${data.year} — ${data.medium}, ${data.dimensions}`}
          aria-label={`View ${data.title} full size`}
        >
          <img
            src={data.image}
            alt={data.altText}
            width="1200"
            height="1500"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style="aspect-ratio: 4 / 5;"
            class="w-full object-cover"
          />
        </button>
        <p class="mt-3 text-xs text-muted">
          &copy; {site.copyrightYear} {site.artistName}. Image shown at reduced resolution; not for reproduction.
        </p>
      </div>

      <div>
        <h1 class="font-serif text-4xl italic leading-tight sm:text-5xl">{data.title}</h1>
        <p class="mt-2 text-muted">{data.year} · {data.medium}</p>

        <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-line py-6 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Dimensions</dt>
            <dd class="mt-1">{data.dimensions}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Collection</dt>
            <dd class="mt-1">{data.collection}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Category</dt>
            <dd class="mt-1">{data.category}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Availability</dt>
            <dd class="mt-1">{data.available ? 'Available' : 'Sold'}</dd>
          </div>
        </dl>

        <div class="prose-body mt-6 text-muted">
          <Content />
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          {data.price && <strong class="text-lg text-accent-dark">{data.price}</strong>}
          <a
            href={`mailto:${site.email}?subject=${encodeURIComponent(`Enquiry about “${data.title}”`)}`}
            class="inline-flex min-h-[2.75rem] items-center justify-center border border-ink bg-ink px-4 py-2 text-xs uppercase tracking-wider text-paper"
          >
            Contact about this work
          </a>
        </div>
      </div>
    </div>

    <nav class="mt-16 flex items-center justify-between border-t border-line pt-6 text-sm" aria-label="Artwork navigation">
      <a href={`/work/${prev.slug}`} class="max-w-[45%] hover:text-accent-dark">
        <span class="block text-xs uppercase tracking-wide text-muted">&larr; Previous</span>
        <span class="font-serif italic">{prev.data.title}</span>
      </a>
      <a href={`/work/${next.slug}`} class="max-w-[45%] text-right hover:text-accent-dark">
        <span class="block text-xs uppercase tracking-wide text-muted">Next &rarr;</span>
        <span class="font-serif italic">{next.data.title}</span>
      </a>
    </nav>
  </article>

  <Lightbox />
</BaseLayout>
