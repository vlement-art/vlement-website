{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/vitest-plugin/types",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
