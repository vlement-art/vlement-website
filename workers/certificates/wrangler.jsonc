{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vlement-certificates",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://vlement.com",
    "ARTWORK_REPOSITORY": "vlement-art/vlement-website"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vlement-certificates-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CERTIFICATE_FILES",
      "bucket_name": "vlement-certificates-local"
    }
  ],
  "ratelimits": [
    {
      "name": "VERIFY_LIMITER",
      "namespace_id": "730001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
